---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { visibleReviews, type ReviewEntry } from '../../lib/catalogue';
import { parseMode } from '../../lib/visibility';

export async function getStaticPaths() {
  const mode = parseMode(import.meta.env.PUBLIC_SITE_MODE);
  const entries = visibleReviews(await getCollection('reviews'), mode);
  return mode === 'preview' || entries.length > 0
    ? [{ params: { path: undefined }, props: { reviews: entries } }]
    : [];
}
const { reviews } = Astro.props as { reviews: ReviewEntry[] };
---
<BaseLayout title={`Reviews | ${site.brand.name}`} description="Customer reviews for Modstyle Crunch And Cream.">
  <main class="support-page page-wrap reviews-page" aria-labelledby="reviews-title">
    <p class="support-page__eyebrow">Shared with permission</p><h1 id="reviews-title">Reviews</h1>
    {reviews.length ? <div class="review-grid">{reviews.map(({ data }) => <article class="review-card">
      {data.sample && <span class="catalogue-sample">Sample content</span>}
      {data.photo && <img src={data.photo.src} alt={data.photo.alt} width="640" height="480" loading="lazy" />}
      <blockquote><p>{data.text}</p></blockquote><p class="review-card__byline"><strong>{data.name}</strong>{data.product && <span> · {data.product}</span>}</p>
    </article>)}</div> : <p class="support-sample">Sample content · Approved customer reviews will appear here when supplied. No reviews are published yet.</p>}
    <p class="reviews-note">Reviews are published only after approval. No ratings or endorsements are inferred.</p>
  </main>
</BaseLayout>
<style>
  @layer reset, tokens, base, components, utilities;
  @layer components {
    .review-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); gap: 1rem; margin-block-start: 2rem; }
    .review-card { padding: clamp(1.2rem, 3vw, 2rem); border: 1px solid var(--sand); border-radius: var(--radius-card); background: white; }
    .review-card img { inline-size: 100%; max-block-size: 18rem; margin-block-end: 1rem; border-radius: .8rem; object-fit: cover; }
    .review-card blockquote { font-family: var(--font-display); font-size: 1.35rem; line-height: 1.3; }
    .review-card__byline { margin-block-start: 1rem; font-size: .9rem; }
    .reviews-note { margin-block-start: 1.5rem; color: #55584f; font-size: .85rem; }
  }
</style>
