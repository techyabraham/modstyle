---
import { site } from '../config/site';
import { parseMode } from '../lib/visibility';
import { localBusinessJsonLd, serializeJsonLd } from '../lib/seo';
import { getCollection } from 'astro:content';
import { visibleGallery } from '../lib/catalogue';
import Wordmark from '../components/Wordmark.astro';
import EnquiryBasket from '../components/EnquiryBasket.astro';
import displayFontUrl from '../assets/fonts/fraunces-latin-ng.woff2?url';
import '../styles/base.css';
import '../styles/tokens.css';
import '../styles/components/buttons.css';
import '../styles/components/cards.css';
import '../styles/components/graphic.css';
import '../styles/components/shell.css';
interface Props { title: string; description: string; jsonLd?: unknown | unknown[] }
const { title, description, jsonLd } = Astro.props;
const mode = parseMode(import.meta.env.PUBLIC_SITE_MODE);
const analyticsId = import.meta.env.PUBLIC_ANALYTICS_ID?.trim();
const canonical = import.meta.env.SITE ? new URL(Astro.url.pathname, import.meta.env.SITE) : null;
const socialImage = import.meta.env.SITE ? new URL('/social-card.png', import.meta.env.SITE) : null;
const structuredData = mode === 'production' ? [localBusinessJsonLd(import.meta.env.SITE), ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])] : [];
const hasGallery = visibleGallery(await getCollection('gallery'), mode).length > 0;
const primaryLinks = [
  { label: 'Home', href: '/' },
  { label: 'Crochet', href: '/crochet/' },
  { label: 'Peanuts', href: '/peanuts/' },
  ...(hasGallery ? [{ label: 'Gallery', href: '/gallery/' }] : []),
  { label: 'FAQ', href: '/faq/' },
  { label: 'Contact', href: '/contact/' },
];
// Shared semantic shell; business content remains behind the visibility gate.
---
<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#163d2b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={displayFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    {mode === 'preview' && <meta name="robots" content="noindex,nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {mode === 'production' && <>
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content={site.brand.name} />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:locale" content="en_NG" />
      {canonical && <meta property="og:url" content={canonical.href} />}
      {socialImage && <><meta property="og:image" content={socialImage.href} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Modstyle Crunch And Cream — crochet and peanuts in Lagos" /></>}
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      {socialImage && <meta name="twitter:image" content={socialImage.href} />}
    </>}
    {structuredData.map(data => <script type="application/ld+json" set:html={serializeJsonLd(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header"><div class="page-wrap site-header__inner" data-site-header-inner>
      <Wordmark />
      <nav class="primary-nav" id="primary-navigation" aria-label="Main navigation" data-primary-nav>
        <ul class="primary-nav__list">{primaryLinks.map(link => <li><a class="primary-nav__link" href={link.href} aria-current={Astro.url.pathname === link.href ? 'page' : undefined}>{link.label}</a></li>)}</ul>
      </nav>
      <div class="site-header__actions"><button class="menu-toggle" type="button" aria-label="Open menu" aria-controls="primary-navigation" aria-expanded="false" data-menu-toggle hidden><svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path class="menu-toggle__bars" d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /><path class="menu-toggle__close" d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg><span>Menu</span></button><EnquiryBasket /></div>
      <p class="site-header__place">Made in Lagos<br />Crochet &amp; peanuts</p>
    </div></header>
    <main class="site-main" id="main"><slot /></main>
  <footer class="site-footer"><div class="page-wrap site-footer__inner"><p class="site-footer__brand">{site.brand.name}</p><nav class="site-footer__nav" aria-label="Supporting pages"><a href="/our-story/">Our story</a>{hasGallery && <a href="/gallery/">Gallery</a>}<a href="/faq/">FAQ</a><a href="/contact/">Contact</a><a href="/policies/">Policies</a></nav><p class="site-footer__location">{site.location}</p></div></footer>
    <script>
      const headerInner = document.querySelector<HTMLElement>('[data-site-header-inner]');
      const primaryNav = document.querySelector<HTMLElement>('[data-primary-nav]');
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      if (headerInner && primaryNav && menuToggle) {
        headerInner.dataset.menuReady = 'true';
        menuToggle.hidden = false;
        const setMenuOpen = (open: boolean, restoreFocus = false) => {
          headerInner.dataset.menuOpen = String(open);
          primaryNav.dataset.open = String(open);
          menuToggle.setAttribute('aria-expanded', String(open));
          menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          menuToggle.querySelector('span')!.textContent = open ? 'Close' : 'Menu';
          if (restoreFocus) menuToggle.focus();
        };
        menuToggle.addEventListener('click', () => {
          const open = headerInner.dataset.menuOpen !== 'true';
          setMenuOpen(open);
          if (open && window.matchMedia('(max-width: 68rem)').matches) primaryNav.querySelector<HTMLAnchorElement>('a')?.focus();
        });
        primaryNav.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setMenuOpen(false)));
        document.addEventListener('keydown', event => {
          if (event.key === 'Escape' && headerInner.dataset.menuOpen === 'true') setMenuOpen(false, true);
        });
        document.addEventListener('pointerdown', event => {
          if (headerInner.dataset.menuOpen === 'true' && event.target instanceof Node && !headerInner.contains(event.target)) setMenuOpen(false);
        });
        window.matchMedia('(min-width: 68.001rem)').addEventListener('change', event => {
          if (event.matches) setMenuOpen(false);
        });
      }
    </script>
    {analyticsId && <script is:inline defer data-domain={analyticsId} src="https://plausible.io/js/script.js"></script>}
    {analyticsId && <script is:inline>
      document.addEventListener('mcc:analytics', event => {
        const detail = event.detail;
        if (detail && typeof detail.name === 'string') window.plausible?.(detail.name, { props: detail.props ?? {} });
      });
      document.addEventListener('click', event => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest('a[href^="https://wa.me/"]');
        if (!link) return;
        const props = {};
        if (link.dataset.analyticsDepartment) props.department = link.dataset.analyticsDepartment;
        if (link.dataset.analyticsProductSlug) props.product_slug = link.dataset.analyticsProductSlug;
        window.plausible?.('whatsapp_click', { props });
      });
    </script>}
  </body>
</html>
