---
interface Props {
  src: string;
  alt: string;
  sizes: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { src, alt, sizes, class: className, loading = 'lazy', fetchpriority } = Astro.props;
const isResponsiveProductPhoto = /^\/images\/products\/(crochet|peanuts)\/[^/]+\.webp$/.test(src);
const isCrochetPhoto = src.startsWith('/images/products/crochet/');
const srcset = isResponsiveProductPhoto
  ? `${src.replace(/\.webp$/, '-240.webp')} 240w, ${src.replace(/\.webp$/, '-480.webp')} 480w, ${src.replace(/\.webp$/, '-800.webp')} 800w, ${src} 1000w`
  : undefined;
const width = 1000;
const height = isCrochetPhoto ? 1250 : 1000;
---
<img src={src} srcset={srcset} sizes={sizes} alt={alt} width={width} height={height} class={className} style="block-size: auto" loading={loading} decoding="async" fetchpriority={fetchpriority} />
