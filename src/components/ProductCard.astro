---
import type { ProductEntry } from '../lib/catalogue';
import { formatNaira, priceLabel } from '../lib/money';
import { buildWhatsAppLink } from '../lib/whatsapp';
import { site } from '../config/site';
import ResponsiveProductImage from './ResponsiveProductImage.astro';

interface Props { product: ProductEntry; departmentTone?: 'crochet' | 'peanuts' }
const { product, departmentTone = product.data.department } = Astro.props;
const item = product.data;
const primaryImage = item.images[0];
const enquiry = buildWhatsAppLink(site.contact.whatsapp, `Hello ${site.brand.name}, I'd like to enquire about ${item.name}. Please confirm availability, total and delivery.`);
const price = item.pricing.type === 'fixed' ? formatNaira(item.pricing.amountNaira) : priceLabel(item.pricing);
---
<article class:list={['catalogue-card', `catalogue-card--${departmentTone}`]} data-product-card data-category={'category' in item ? item.category : ''} data-wearer={'intendedWearer' in item ? item.intendedWearer ?? '' : ''} data-price-type={item.pricing.type}>
  <a class="catalogue-card__art" data-department={item.department} href={`/products/${item.slug}/`} aria-label={`View ${item.name}`}>
    {primaryImage ? <ResponsiveProductImage src={primaryImage.src} alt={primaryImage.alt} sizes="(max-width: 42rem) 100vw, (max-width: 70rem) 50vw, 33vw" /> : <div class="catalogue-card__art-fallback" aria-hidden="true"><span>{departmentTone === 'crochet' ? 'Crochet' : 'Peanuts'}</span></div>}
  </a>
  <div class="catalogue-card__body">
    <div class="catalogue-card__meta"><span>{item.department === 'crochet' ? item.category : 'Bulk enquiry'}</span></div>
    <h3><a href={`/products/${item.slug}/`}>{item.name}</a></h3>
    <p>{item.summary}</p>
    <div class="catalogue-card__footer">
      <strong class="catalogue-card__price">{price}</strong>
      <div class="catalogue-card__actions">
        <a class="catalogue-card__details" href={`/products/${item.slug}/`}><span class="catalogue-card__details-long">View details</span><span class="catalogue-card__details-short">Details</span> <span aria-hidden="true">→</span></a>
        <a class="catalogue-card__enquire" data-analytics-whatsapp data-analytics-department={item.department} data-analytics-product-slug={item.slug} href={enquiry}>Enquire <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</article>
