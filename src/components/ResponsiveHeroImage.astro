---
interface Props {
  image: string;
  alt: string;
  sizes: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { image, alt, sizes, class: className, loading = 'eager', fetchpriority = 'auto' } = Astro.props;
const base = `/images/brand/heroes/${image}`;
const srcset = [480, 800, 1200, 1672]
  .map(width => `${base}-${width}.webp ${width}w`)
  .join(', ');
---
<img
  src={`${base}-1200.webp`}
  srcset={srcset}
  sizes={sizes}
  alt={alt}
  width="1672"
  height="941"
  class={className}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
/>
