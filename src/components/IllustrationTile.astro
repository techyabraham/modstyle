---
import { isPublishable, parseMode } from '../lib/visibility';
interface Props { variant: 'yarn' | 'granny' | 'top' | 'tote' | 'beanie' | 'peanuts' | 'sack'; alt: string }
const { variant, alt } = Astro.props;
const mode = parseMode(import.meta.env.PUBLIC_SITE_MODE);
const visible = isPublishable({ sample: true, required: [alt] }, mode);
const department = variant === 'peanuts' || variant === 'sack' ? 'peanuts' : 'crochet';
// Preview-only illustrated tile, always visibly identified as sample content.
---
{visible && <div class="art-tile" data-department={department} role="img" aria-label={alt}>
  <span class="art-tile__badge">Sample content</span>
  <svg class="art-tile__drawing" viewBox="0 0 240 240" fill="none" aria-hidden="true">
    {variant === 'yarn' && <g stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="113" cy="119" r="65" fill="var(--cream)" />
      <path d="M58 90c48 4 93 43 103 86M51 119c58-5 94-25 115-52M76 67c-3 43 38 92 96 105M103 54c-14 49 8 99 50 122M105 181c-15 18-21 29-12 42" />
    </g>}
    {variant === 'granny' && <g stroke="currentColor" stroke-width="5" stroke-linejoin="round">
      <rect x="35" y="35" width="170" height="170" rx="16" fill="var(--cream)" />
      <rect x="56" y="56" width="128" height="128" rx="13" stroke-dasharray="9 8" />
      <path d="M120 77c17 15 26 30 26 43s-9 28-26 43c-17-15-26-30-26-43s9-28 26-43Z" fill="var(--magenta-soft)" />
      <path d="M77 120h86M120 77v86" />
    </g>}
    {variant === 'top' && <g stroke="currentColor" stroke-width="5" stroke-linejoin="round">
      <path d="m80 45-39 24 22 45 25-12v96h64v-96l25 12 22-45-39-24-17 17h-46L80 45Z" fill="var(--cream)" />
      <path d="M97 63c7 18 39 18 46 0M90 114h60M90 130h60M90 146h60M90 162h60" stroke-dasharray="6 9" />
    </g>}
    {variant === 'tote' && <g stroke="currentColor" stroke-width="5" stroke-linejoin="round">
      <path d="M57 94h126l-11 112H68L57 94Z" fill="var(--cream)" />
      <path d="M84 98V76c0-20 14-35 36-35s36 15 36 35v22M94 129c22 15 44 15 66 0M92 156c27 12 47 12 68 0" />
    </g>}
    {variant === 'beanie' && <g stroke="currentColor" stroke-width="5" stroke-linejoin="round">
      <circle cx="120" cy="53" r="16" fill="var(--cream)" />
      <path d="M55 152V112c0-41 28-65 65-65s65 24 65 65v40H55Z" fill="var(--cream)" />
      <rect x="49" y="146" width="142" height="42" rx="10" fill="var(--magenta-soft)" />
      <path d="M70 162l12 13 12-13 12 13 12-13 12 13 12-13 12 13 12-13" />
    </g>}
    {variant === 'peanuts' && <g stroke="currentColor" stroke-width="4" stroke-linejoin="round">
      <path d="M86 61c-30 5-45 34-34 59 7 16 6 25 4 38-3 22 19 43 44 37 15-4 25-16 27-30 3-21-12-38-7-57 6-23-9-51-34-47Z" fill="var(--cream)" />
      <path d="M157 44c-28 1-44 27-36 54 6 19 4 33-2 44-13 24 3 50 27 54 29 5 47-15 45-38-2-18-3-26 1-41 9-32-6-69-35-73Z" fill="var(--cream)" />
      <path d="M70 96l27 25-30 25M80 72l22 27-31 27M141 69l30 28-29 31M149 126l26 28-29 25" opacity=".75" />
    </g>}
    {variant === 'sack' && <g stroke="currentColor" stroke-width="5" stroke-linejoin="round">
      <path d="M83 41h74l-13 39c27 31 46 58 44 88-1 29-23 41-68 41s-67-12-68-41c-2-30 17-57 44-88L83 41Z" fill="var(--cream)" />
      <path d="M82 81h76M98 49c14 12 30 12 44 0M94 143c16-18 36-18 52 0M97 165c15 13 31 13 46 0" />
      <circle cx="120" cy="130" r="6" fill="currentColor" stroke="none" />
    </g>}
  </svg>
</div>}
